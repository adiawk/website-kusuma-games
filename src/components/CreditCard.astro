---
import type { CreditGame } from "../data/credits";

interface Props {
	game: CreditGame;
}

const { game } = Astro.props;
---

{
	game.itchUrl ? (
		<a href={game.itchUrl} rel="noreferrer" class="group relative block overflow-hidden">
			<img
				src={game.cover}
				alt={game.title}
				class="aspect-[3/4] w-full object-cover object-center transition duration-500 group-hover:scale-[1.04]"
			/>
			<div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-ink/85 via-ink/20 to-transparent p-3 opacity-0 transition group-hover:opacity-100">
				<p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-ember-2">{game.role}</p>
				<h3 class="font-display text-base font-bold text-paper">{game.title}</h3>
			</div>
		</a>
	) : (
		<article class="group relative overflow-hidden">
			<img
				src={game.cover}
				alt={game.title}
				class="aspect-[3/4] w-full object-cover object-center"
			/>
			<div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-ink/85 via-ink/20 to-transparent p-3 opacity-0 transition group-hover:opacity-100">
				<p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-ember-2">{game.role}</p>
				<h3 class="font-display text-base font-bold text-paper">{game.title}</h3>
			</div>
		</article>
	)
}

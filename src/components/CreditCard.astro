---
import type { CreditGame } from "../data/credits";

interface Props {
	game: CreditGame;
}

const { game } = Astro.props;
---

<article class="overflow-hidden rounded-2xl border border-white/8 bg-navy-2">
	<div class="aspect-[16/10] overflow-hidden bg-navy-3">
		<img src={game.cover} alt="" class="h-full w-full object-cover" />
	</div>
	<div class="p-5">
		<p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">
			{game.year} · {game.genre}
		</p>
		<h3 class="font-display mt-1 text-lg font-bold text-paper">{game.title}</h3>
		<p class="mt-1 text-xs font-semibold text-ember-2">{game.role}</p>
		<p class="mt-2 text-sm leading-relaxed text-muted">{game.blurb}</p>
		{
			game.itchUrl && (
				<a
					class="mt-3 inline-block text-sm font-semibold text-sky hover:text-paper"
					href={game.itchUrl}
					rel="noreferrer"
				>
					itch.io page
				</a>
			)
		}
	</div>
</article>

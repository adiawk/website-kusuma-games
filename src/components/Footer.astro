---
import { studio } from "../data/studio";
import { games } from "../data/games";

const legal = [
	{ href: "/privacy/", label: "Privacy Policy" },
	{ href: "/terms/", label: "Terms of Service" },
	{ href: "/support/", label: "Support" },
	{ href: "/account-deletion/", label: "Account deletion" },
];
---

<footer id="contact" class="mt-auto scroll-mt-24 bg-navy text-paper">
	<div class="geo-band h-14" aria-hidden="true"></div>
	<div class="mx-auto max-w-5xl px-5 py-16 text-center">
		<h2 class="font-display text-[22px] font-bold uppercase tracking-[0.18em]">Contact</h2>
		<span class="mx-auto mt-3 block h-[5px] w-[52px] bg-ember"></span>
	</div>
	<div class="mx-auto grid max-w-5xl gap-12 px-5 pb-16 text-center md:grid-cols-3 md:text-left">
		<div>
			<h3 class="font-display text-lg font-bold">Players & press</h3>
			<p class="mt-3 text-sm leading-relaxed text-muted">
				For bugs, store review, and press, email a real person at Kusuma Games.
			</p>
			<p class="mt-4">
				<a class="text-ember-2 hover:text-paper" href={`mailto:${studio.email}`}>{studio.email}</a>
			</p>
			<p class="mt-2">
				<a class="text-sm text-muted hover:text-paper" href="/support/">Support</a>
			</p>
		</div>
		<div>
			<h3 class="font-display text-lg font-bold">Studio</h3>
			<p class="mt-3 text-sm leading-relaxed text-muted">
				{studio.legalName}<br />
				{studio.founder}<br />
				{studio.region}
			</p>
			<p class="mt-4">
				<a class="text-sm text-ember-2 hover:text-paper" href={studio.itchUrl} rel="noreferrer">
					itch.io
				</a>
			</p>
		</div>
		<div>
			<h3 class="font-display text-lg font-bold">Games & legal</h3>
			<ul class="mt-3 space-y-2 text-sm">
				{
					games.slice(0, 3).map((game) => (
						<li>
							<a class="text-paper/80 hover:text-ember-2" href={`/games/${game.slug}/`}>
								{game.shortTitle}
							</a>
						</li>
					))
				}
				{
					legal.map((item) => (
						<li>
							<a class="text-muted hover:text-paper" href={item.href}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
	<div class="border-t border-white/10">
		<div
			class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-5 text-center text-xs text-muted sm:flex-row sm:justify-between sm:text-left"
		>
			<p>© {new Date().getFullYear()} {studio.legalName}. {studio.region}.</p>
			<p>Made by {studio.founder}.</p>
		</div>
	</div>
</footer>

---
import { studio } from "../data/studio";
import { games } from "../data/games";
import Wordmark from "./Wordmark.astro";

const legal = [
	{ href: "/privacy/", label: "Privacy Policy" },
	{ href: "/terms/", label: "Terms of Service" },
	{ href: "/support/", label: "Support" },
	{ href: "/contact/", label: "Contact" },
	{ href: "/account-deletion/", label: "Account deletion" },
];
---

<footer class="mt-auto border-t border-line bg-navy">
	<div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-4">
		<div class="md:col-span-1">
			<Wordmark />
			<p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
				{studio.shortDescription}
			</p>
		</div>
		<div>
			<p class="font-display text-xs font-bold tracking-[0.2em] text-sky">GAMES</p>
			<ul class="mt-3 space-y-2">
				{
					games.slice(0, 4).map((game) => (
						<li>
							<a class="text-sm text-paper/80 hover:text-ember-2" href={`/games/${game.slug}/`}>
								{game.shortTitle}
							</a>
						</li>
					))
				}
				<li>
					<a class="text-sm text-muted hover:text-paper" href="/games/">All games</a>
				</li>
			</ul>
		</div>
		<div>
			<p class="font-display text-xs font-bold tracking-[0.2em] text-sky">STUDIO</p>
			<ul class="mt-3 space-y-2">
				<li><a class="text-sm text-paper/80 hover:text-ember-2" href="/about/">About</a></li>
				<li>
					<a class="text-sm text-paper/80 hover:text-ember-2" href={studio.itchUrl} rel="noreferrer">
						itch.io
					</a>
				</li>
				<li>
					<a class="text-sm text-paper/80 hover:text-ember-2" href={`mailto:${studio.email}`}>
						{studio.email}
					</a>
				</li>
			</ul>
		</div>
		<div>
			<p class="font-display text-xs font-bold tracking-[0.2em] text-sky">LEGAL</p>
			<ul class="mt-3 space-y-2">
				{
					legal.map((item) => (
						<li>
							<a class="text-sm text-paper/80 hover:text-ember-2" href={item.href}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
	<div class="border-t border-line">
		<div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 text-xs text-muted sm:flex-row sm:justify-between">
			<p>© {new Date().getFullYear()} {studio.legalName}. {studio.region}.</p>
			<p>Made by {studio.founder}.</p>
		</div>
	</div>
</footer>

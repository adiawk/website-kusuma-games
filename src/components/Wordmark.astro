---
interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<a href="/" class:list={["group inline-flex items-center gap-2.5", className]} aria-label="Kusuma Games home">
	<img
		src="/images/logo.png"
		alt=""
		width="36"
		height="36"
		class="size-9 rounded-[10px] ring-1 ring-white/10"
	/>
	<span class="leading-none">
		<span class="font-display block text-[15px] font-extrabold tracking-[0.18em] text-paper">KUSUMA</span>
		<span class="font-display block text-[10px] font-semibold tracking-[0.32em] text-sky">GAMES</span>
	</span>
</a>

---
import Layout from "../layouts/Layout.astro";
import CreditCard from "../components/CreditCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { studio } from "../data/studio";
import { awards, creditStudios } from "../data/credits";
---

<Layout
	title="About"
	description={`About ${studio.name}, the indie Unity studio founded by ${studio.founder}.`}
>
	<section class="bg-navy px-5 py-16 text-paper md:py-20">
		<div class="mx-auto max-w-3xl">
			<p class="font-display text-xs font-bold tracking-[0.22em] text-ember-2">ABOUT</p>
			<h1 class="font-display mt-3 text-4xl font-extrabold md:text-5xl">{studio.name}</h1>
			<p class="mt-5 text-lg leading-relaxed text-muted">{studio.about}</p>
		</div>
	</section>

	<section class="mx-auto max-w-3xl px-5 py-14">
		<SectionHeading title="Who we are" align="left" />
		<p class="mt-8 leading-relaxed text-ash">
			{studio.founder} is a Unity game programmer and indie developer. After years shipping mobile
			and simulation games with other studios, Kusuma Games is the home for original work — starting
			with{" "}
			<a class="font-semibold text-ember hover:text-ink" href="/games/stationery-defenders/">
				Stationery Defenders
			</a>.
		</p>
		<p class="mt-4 leading-relaxed text-ash">
			The studio is based in {studio.region}. We work in Unity, care about readable gameplay, and
			publish first on itch.io while store builds are in progress.
		</p>

		<div class="mt-14">
			<SectionHeading title="Recognition" align="left" />
			<ul class="mt-8 grid gap-4">
				{
					awards.map((award) => (
						<li class="border border-ink/10 bg-paper-2 p-5">
							<p class="font-semibold text-ink">{award.title}</p>
							<p class="text-sm text-ash">
								{award.year} · {award.work}
							</p>
						</li>
					))
				}
			</ul>
		</div>

		<p class="mt-10 text-sm text-ash">
			Playable builds and older projects live on{" "}
			<a class="font-semibold text-ember hover:text-ink" href={studio.itchUrl} rel="noreferrer">
				itch.io
			</a>. For press, players, or store review, use{" "}
			<a class="font-semibold text-ember hover:text-ink" href={`mailto:${studio.email}`}>
				{studio.email}
			</a>.
		</p>
	</section>

	<section class="border-t border-ink/10 bg-paper px-5 py-16">
		<SectionHeading title="Selected Credits" />
		<p class="mx-auto mt-6 max-w-2xl text-center text-ash">
			Shipped as a programmer with other studios. Not Kusuma Games products.
		</p>
		{
			creditStudios.map((group) => (
				<div class="mx-auto mt-12 max-w-5xl">
					<h3 class="font-display text-center text-xl font-bold">
						{group.studio}
						<span class="text-base font-normal text-ash"> · {group.years}</span>
					</h3>
					<div class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4">
						{group.games.map((game) => (
							<CreditCard game={game} />
						))}
					</div>
				</div>
			))
		}
	</section>
</Layout>

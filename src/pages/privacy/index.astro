---
import Layout from "../../layouts/Layout.astro";
import LegalDoc from "../../components/LegalDoc.astro";
import { studio } from "../../data/studio";
import { games } from "../../data/games";

const published = games.filter(
	(game) => game.hasAccounts || game.usesAds || game.usesIap || game.usesFirebase,
);
---

<Layout
	title="Privacy Policy"
	description={`Privacy Policy for ${studio.name} games. How we handle player data, accounts, Unity LevelPlay ads, purchases, Cloudflare D1, and Firebase Analytics.`}
>
	<LegalDoc
		eyebrow="LEGAL"
		title="Privacy Policy"
		lede={`${studio.legalName} (“we”, “us”). Last updated ${studio.lastUpdated}. This is a public policy for store listings and players — not legal advice.`}
	>
		<p>
			This policy describes how {studio.legalName} handles information when you play our games or
			use this website. The operator is {studio.founder}, based in {studio.region}.
		</p>
		<p>
			Contact: <a href={`mailto:${studio.email}`}>{studio.email}</a>
		</p>

		<h2>Who this covers</h2>
		<p>
			This studio-wide policy applies to this website and to original Kusuma Games titles. Each
			game also has its own page for Google Play and App Store Connect:
		</p>
		<ul>
			{
				games.map((game) => (
					<li>
						<a href={`/privacy/${game.slug}/`}>{game.title}</a>
					</li>
				))
			}
		</ul>
		<p>
			Games credited from other studios (Kajewdev, AimToMite, Artbid, and similar) are not operated
			by {studio.name}. Their publishers’ policies apply.
		</p>

		<h2>Published mobile games</h2>
		<p>
			Our store-released mobile games — currently{" "}
			{
				published.map((game, index) => (
					<>
						{index > 0 && ", "}
						<a href={`/privacy/${game.slug}/`}>{game.title}</a>
					</>
				))
			}{" "}
			— let you choose <strong>Google Sign-In</strong> or <strong>guest login</strong>, show{" "}
			<strong>ads via Unity LevelPlay</strong>, offer <strong>in-app purchases</strong>, store
			login and saves in <strong>Cloudflare D1</strong>, and use <strong>Firebase Analytics</strong>{" "}
			for tracking.
		</p>
		<p>Depending on how you play, we and our partners may process:</p>
		<ul>
			<li>
				<strong>Google Sign-In:</strong> a Google user ID and, when Google shares them, your name
				and email, so we can create and restore your profile in our database.
			</li>
			<li>
				<strong>Guest login:</strong> an anonymous player ID we create, stored in Cloudflare D1,
				tied to the install until you link a Google account.
			</li>
			<li>
				<strong>Gameplay and save data:</strong> progress, settings, and entitlements stored on
				device and in <strong>Cloudflare D1</strong> (our game database).
			</li>
			<li>
				<strong>Ads:</strong> advertising identifiers and device information used by{" "}
				<strong>Unity LevelPlay</strong> and the ad networks it mediates, to serve and measure ads.
				This can include personalized ads unless you limit ad tracking on the device or we treat
				the session as child-directed.
			</li>
			<li>
				<strong>In-app purchases:</strong> product IDs and store purchase tokens from Google Play
				or the App Store. We do not receive your full payment card number. Entitlements may be
				stored in D1.
			</li>
			<li>
				<strong>Firebase tracking:</strong> Analytics events, device and app version, crash or
				performance data, and identifiers used to operate and improve the game. Firebase is not
				used for login or save data.
			</li>
		</ul>
		<p>
			Partners process data under their own policies:
		</p>
		<ul>
			<li>
				<a href="https://policies.google.com/privacy" rel="noreferrer">Google Privacy Policy</a>{" "}
				(Sign-In, Play, Firebase Analytics)
			</li>
			<li>
				<a href="https://unity.com/legal/privacy-policy" rel="noreferrer">Unity Privacy Policy</a>{" "}
				(Unity LevelPlay ads)
			</li>
			<li>
				<a href="https://www.cloudflare.com/privacypolicy/" rel="noreferrer">Cloudflare Privacy Policy</a>{" "}
				(D1 database and this website)
			</li>
			<li>
				<a href="https://www.apple.com/legal/privacy/" rel="noreferrer">Apple Privacy Policy</a>{" "}
				(App Store purchases on iOS)
			</li>
			<li>
				<a href="https://firebase.google.com/support/privacy" rel="noreferrer">Firebase Privacy</a>{" "}
				(Analytics)
			</li>
		</ul>

		<h2>This website and older experiments</h2>
		<p>We may also receive:</p>
		<ul>
			<li>
				<strong>Email you send us</strong> (support, feedback, deletion requests). We use it only
				to reply and to fix issues.
			</li>
			<li>
				<strong>Standard website logs</strong> from Cloudflare (IP address, user agent, page
				requested) to serve and protect the site. See{" "}
				<a href="https://www.cloudflare.com/privacypolicy/" rel="noreferrer">Cloudflare’s privacy policy</a>{" "}
				for website logs. The same Cloudflare account also hosts D1 game data for published mobile
				titles.
			</li>
			<li>
				<strong>itch.io</strong> when you play or download jam or prototype builds there.
			</li>
		</ul>

		<h2>What we do not do</h2>
		<ul>
			<li>We do not sell your personal information.</li>
			<li>We do not receive your full credit-card number from in-app purchases.</li>
			<li>We do not use children’s personal information for targeted advertising.</li>
		</ul>

		<h2>Children</h2>
		<p>
			Our games may have a general / Everyone store rating, but <strong>Google Sign-In is not
			for children under 13</strong>. Players under 13 should use guest play only with a parent’s
			permission, or not use the game. We do not knowingly create Google-linked accounts for
			children. Personalized ads are not intended for children. If you believe a child has given us
			personal information, email <a href={`mailto:${studio.email}`}>{studio.email}</a> and we will
			delete it.
		</p>

		<h2>Your requests</h2>
		<p>
			Email <a href={`mailto:${studio.email}`}>{studio.email}</a> to access, correct, or delete
			information we hold, including a game account. See{" "}
			<a href="/account-deletion/">account deletion</a> for the store-required web flow.
		</p>

		<h2>This website</h2>
		<p>
			This site is a static studio page at kusumagames.com. It does not set first-party analytics
			cookies. Hosting and CDN services may process technical data as described above.
		</p>
	</LegalDoc>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import LegalDoc from "../components/LegalDoc.astro";
import { studio } from "../data/studio";
import { games } from "../data/games";
---

<Layout
	title="Terms of Service"
	description={`Terms of Service for ${studio.name} games, including accounts, ads, and in-app purchases.`}
>
	<LegalDoc
		eyebrow="LEGAL"
		title="Terms of Service"
		lede={`Last updated ${studio.lastUpdated}. These terms are a simple license for players — not legal advice.`}
	>
		<p>
			By playing a Kusuma Games title or using this website, you agree to these terms. If you do
			not agree, do not use the games or the site.
		</p>
		<p>
			Operator: {studio.legalName} ({studio.founder}), {studio.region}. Contact:{" "}
			<a href={`mailto:${studio.email}`}>{studio.email}</a>
		</p>

		<h2>License</h2>
		<p>
			We grant you a personal, non-exclusive, non-transferable, revocable license to play our games
			for your own entertainment. You do not own the games, art, audio, code, or virtual items. You
			may not redistribute, sell, reverse engineer (except where the law allows), or claim our work
			as yours.
		</p>

		<h2>Our games</h2>
		<ul>
			{games.map((game) => (
				<li>
					<a href={`/games/${game.slug}/`}>{game.title}</a>
				</li>
			))}
		</ul>
		<p>
			itch.io, Google Play, and the App Store have their own terms. Those apply in addition to
			these when you use those stores.
		</p>

		<h2>Accounts</h2>
		<p>
			Published mobile games may let you play as a <strong>guest</strong> or sign in with{" "}
			<strong>Google</strong>. Profiles and cloud saves are stored in our Cloudflare D1 database.
			You are responsible for the Google account you use. Guest progress may be lost if you
			uninstall, change devices, or clear app data before linking Google. We may suspend or delete
			accounts that break these terms or store rules.
		</p>
		<p>
			To delete an account, use the in-game option or{" "}
			<a href="/account-deletion/">account deletion</a>.
		</p>

		<h2>Ads</h2>
		<p>
			Games may show advertisements through Unity LevelPlay (and networks it mediates). Ads are
			provided by third parties. We are not responsible for the content of those ads. Do not
			interact with ads in a way that tries to defraud the ad network.
		</p>

		<h2>In-app purchases</h2>
		<p>
			Optional in-app purchases are billed by Google Play or the Apple App Store. Virtual currency,
			items, and cosmetics are licensed to you; they have no real-world cash value and are not
			refundable from Kusuma Games except where the store or the law requires it. Ask the store
			for billing disputes and refunds. Prices and offers can change.
		</p>

		<h2>Content and conduct</h2>
		<p>
			Do not use our games or site for anything illegal, to harass others, or to cheat in a way
			that harms other players. We may stop offering a game or a build at any time.
		</p>

		<h2>Disclaimer</h2>
		<p>
			Games and this site are provided “as is”. We make no warranty that they will be error-free,
			uninterrupted, or fit for a particular purpose. To the fullest extent allowed by law,{" "}
			{studio.legalName} is not liable for indirect or consequential damages, or for data loss on
			your device.
		</p>

		<h2>Privacy</h2>
		<p>
			How we handle information — including Google Sign-In, guest IDs, Cloudflare D1 saves, Unity
			LevelPlay ads, purchases, and Firebase Analytics — is described in the{" "}
			<a href="/privacy/">Privacy Policy</a>.
		</p>

		<h2>Changes</h2>
		<p>
			We may update these terms. The date at the top is the latest version. Continued use after a
			change means you accept the new terms.
		</p>
	</LegalDoc>
</Layout>

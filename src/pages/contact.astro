---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { studio } from "../data/studio";
---

<Layout
	title="Contact"
	description={`Contact ${studio.name} at ${studio.email}.`}
>
	<section class="bg-navy px-5 py-16 text-center text-paper md:py-20">
		<p class="font-display text-xs font-bold tracking-[0.22em] text-ember-2">STUDIO</p>
		<h1 class="font-display mt-3 text-4xl font-extrabold md:text-5xl">Contact</h1>
		<p class="mt-4 text-lg text-muted">For players, store review, and press.</p>
	</section>
	<section class="bg-paper px-5 py-16 md:py-20">
		<SectionHeading title="Contact" />
		<div class="mx-auto mt-12 grid max-w-4xl gap-12 md:grid-cols-2">
			<div>
				<h2 class="font-display text-lg font-bold">Email</h2>
				<p class="mt-3 leading-relaxed text-ash">
					A real person reads this inbox. Use it for bugs, store questions, privacy requests, and
					press.
				</p>
				<p class="mt-4">
					<a class="font-semibold text-ember hover:text-ink" href={`mailto:${studio.email}`}>
						{studio.email}
					</a>
				</p>
				<p class="mt-2">
					<a class="text-sm text-ash hover:text-ink" href="/support/">Support pages</a>
				</p>
			</div>
			<div>
				<h2 class="font-display text-lg font-bold">Studio</h2>
				<p class="mt-3 leading-relaxed text-ash">
					{studio.legalName}<br />
					{studio.founder}<br />
					{studio.region}
				</p>
				<p class="mt-4">
					<a class="font-semibold text-ember hover:text-ink" href={studio.itchUrl} rel="noreferrer">
						{studio.itchUrl}
					</a>
				</p>
				<ul class="mt-4 space-y-1 text-sm">
					<li><a class="text-ember hover:text-ink" href="/privacy/">Privacy Policy</a></li>
					<li><a class="text-ember hover:text-ink" href="/terms/">Terms of Service</a></li>
					<li><a class="text-ember hover:text-ink" href="/games/">Games</a></li>
				</ul>
			</div>
		</div>
	</section>
</Layout>

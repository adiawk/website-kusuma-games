---
import Layout from "../layouts/Layout.astro";
import GameCard from "../components/GameCard.astro";
import CreditCard from "../components/CreditCard.astro";
import { studio } from "../data/studio";
import { featuredGame, games } from "../data/games";
import { creditStudios } from "../data/credits";

const originals = games.filter((game) => !game.featured);
---

<Layout
	title={studio.name}
	description={`${studio.name} — ${studio.tagline}. ${featuredGame.tagline}`}
	image={featuredGame.cover}
>
	<section class="relative overflow-hidden border-b border-line bg-grid bg-glow">
		<div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-2 md:py-24">
			<div>
				<p class="font-display text-xs font-bold tracking-[0.28em] text-sky">INDIE GAME STUDIO</p>
				<h1 class="font-display mt-4 text-5xl font-extrabold leading-[0.95] tracking-tight md:text-7xl">
					{studio.name}
				</h1>
				<p class="mt-5 max-w-md text-lg leading-relaxed text-muted">
					{studio.tagline}. Playful systems, readable fantasy, built in Unity — starting with
					mobile.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href={`/games/${featuredGame.slug}/`}
						class="rounded-full bg-ember px-5 py-2.5 text-sm font-bold text-ink hover:bg-ember-2"
					>
						See Stationery Defenders
					</a>
					<a
						href="/games/"
						class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-bold text-paper hover:border-white/30"
					>
						All games
					</a>
				</div>
			</div>
			<a
				href={`/games/${featuredGame.slug}/`}
				class="relative overflow-hidden rounded-3xl border border-white/10 shadow-2xl"
			>
				<img
					src={featuredGame.cover}
					alt={featuredGame.title}
					class="aspect-[4/5] w-full object-cover md:aspect-[4/5]"
				/>
				<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent p-5">
					<p class="text-xs font-bold uppercase tracking-[0.16em] text-ember-2">Featured · Mobile</p>
					<p class="font-display text-2xl font-bold">{featuredGame.shortTitle}</p>
				</div>
			</a>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
		<div class="grid items-start gap-10 md:grid-cols-2">
			<div>
				<p class="font-display text-xs font-bold tracking-[0.22em] text-sky">FEATURED GAME</p>
				<h2 class="font-display mt-3 text-3xl font-extrabold md:text-4xl">{featuredGame.title}</h2>
				<p class="mt-4 text-muted leading-relaxed">{featuredGame.longDescription}</p>
				<ul class="mt-6 space-y-2 text-sm text-paper/90">
					{
						featuredGame.features.map((feature) => (
							<li class="flex gap-2">
								<span class="text-ember">▸</span>
								{feature}
							</li>
						))
					}
				</ul>
				<div class="mt-8 flex flex-wrap gap-3">
					{
						featuredGame.playUrl && (
							<a
								href={featuredGame.playUrl}
								rel="noreferrer"
								class="rounded-full bg-ember px-5 py-2.5 text-sm font-bold text-ink hover:bg-ember-2"
							>
								Play on itch.io
							</a>
						)
					}
					<a
						href={`/games/${featuredGame.slug}/`}
						class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-bold hover:border-white/30"
					>
						Game page
					</a>
				</div>
			</div>
			<div class="grid grid-cols-2 gap-3">
				{
					featuredGame.screenshots.map((shot, index) => (
						<img
							src={shot}
							alt={`${featuredGame.shortTitle} screenshot ${index + 1}`}
							class:list={[
								"rounded-2xl border border-white/8 object-cover",
								index === 0 ? "col-span-2 aspect-[16/9]" : "aspect-[4/5]",
							]}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-y border-line bg-navy">
		<div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
			<div class="flex items-end justify-between gap-4">
				<div>
					<p class="font-display text-xs font-bold tracking-[0.22em] text-sky">OUR GAMES</p>
					<h2 class="font-display mt-3 text-3xl font-extrabold">Made at Kusuma Games</h2>
				</div>
				<a href="/games/" class="hidden text-sm font-semibold text-sky hover:text-paper sm:inline">
					View all
				</a>
			</div>
			<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				<GameCard game={featuredGame} />
				{originals.slice(0, 5).map((game) => <GameCard game={game} />)}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
		<p class="font-display text-xs font-bold tracking-[0.22em] text-sky">SELECTED CREDITS</p>
		<h2 class="font-display mt-3 text-3xl font-extrabold">Shipped as a programmer with other studios</h2>
		<p class="mt-3 max-w-2xl text-muted">
			These titles were made at other companies. They are listed here as work credits — not as Kusuma
			Games products.
		</p>
		{
			creditStudios.map((group) => (
				<div class="mt-10">
					<div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<h3 class="font-display text-xl font-bold">{group.studio}</h3>
						<span class="text-sm text-muted">
							{group.years} · {group.engagement}
						</span>
					</div>
					<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
						{group.games.map((game) => (
							<CreditCard game={game} />
						))}
					</div>
				</div>
			))
		}
	</section>

	<section class="border-t border-line bg-navy-2">
		<div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-2 md:items-center">
			<div>
				<p class="font-display text-xs font-bold tracking-[0.22em] text-sky">THE STUDIO</p>
				<h2 class="font-display mt-3 text-3xl font-extrabold">A one-person Unity studio</h2>
				<p class="mt-4 leading-relaxed text-muted">{studio.about}</p>
				<a
					href="/about/"
					class="mt-6 inline-block text-sm font-bold text-ember-2 hover:text-paper"
				>
					More about Kusuma Games →
				</a>
			</div>
			<div class="rounded-3xl border border-white/10 bg-ink p-8">
				<p class="text-sm text-muted">Need the store URLs?</p>
				<p class="font-display mt-2 text-2xl font-bold">Privacy, support, and terms are live.</p>
				<ul class="mt-5 space-y-2 text-sm">
					<li><a class="text-sky hover:text-paper" href="/privacy/">Privacy Policy</a></li>
					<li><a class="text-sky hover:text-paper" href="/support/">Support</a></li>
					<li><a class="text-sky hover:text-paper" href="/terms/">Terms of Service</a></li>
					<li>
						<a class="text-sky hover:text-paper" href={`mailto:${studio.email}`}>{studio.email}</a>
					</li>
				</ul>
			</div>
		</div>
	</section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import GameCard from "../components/GameCard.astro";
import CreditCard from "../components/CreditCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Wordmark from "../components/Wordmark.astro";
import { studio } from "../data/studio";
import { featuredGame, games } from "../data/games";
import { awards, creditStudios } from "../data/credits";

const creditGames = creditStudios.flatMap((group) => group.games);
const heroImage = "/images/hero-stationery-defenders.png";
---

<Layout
	title={studio.name}
	description={`${studio.name} — ${studio.tagline}. ${featuredGame.tagline}`}
	image={heroImage}
	overlayHeader
>
	<section class="relative min-h-screen overflow-hidden bg-ink text-paper">
		<img
			src={heroImage}
			alt=""
			class="absolute inset-0 h-full w-full object-cover object-center"
		/>
		<div class="absolute inset-0 bg-ink/35"></div>
		<div class="geo-overlay absolute inset-0"></div>
		<div class="relative z-10 flex min-h-screen flex-col items-center justify-center px-5 pb-16 pt-24 text-center">
			<Wordmark size="lg" linked={false} />
			<p class="mt-8 max-w-md text-lg tracking-wide text-paper/90 md:text-xl">
				{studio.tagline}.
			</p>
			<a href="#games" class="mt-14 flex flex-col items-center gap-3 text-paper/80 hover:text-ember-2">
				<span class="scroll-mouse" aria-hidden="true"></span>
				<span class="text-xs tracking-[0.2em] uppercase">Scroll</span>
			</a>
		</div>
		{
			studio.itchUrl && (
				<a
					href={studio.itchUrl}
					rel="noreferrer"
					class="absolute bottom-8 left-6 z-10 border border-white/25 bg-ink/40 px-3 py-1.5 text-xs font-semibold tracking-wide text-paper backdrop-blur-sm hover:border-ember hover:text-ember-2"
				>
					Play on itch.io
				</a>
			)
		}
		<a
			href={`/games/${featuredGame.slug}/`}
			class="absolute bottom-8 right-6 z-10 text-xs font-semibold tracking-wide text-paper/80 hover:text-ember-2"
		>
			{featuredGame.shortTitle} →
		</a>
	</section>

	<section id="games" class="scroll-mt-24 bg-paper px-5 py-20 md:py-24">
		<SectionHeading title="Our Games" />
		<div class="mx-auto mt-12 grid max-w-[920px] grid-cols-2 gap-2 md:grid-cols-3">
			{games.map((game) => <GameCard game={game} />)}
		</div>
	</section>

	<div class="geo-band h-14" aria-hidden="true"></div>

	<section id="about" class="scroll-mt-24 bg-paper">
		<div class="grid md:grid-cols-2">
			<div class="flex flex-col justify-center px-8 py-16 md:px-16 md:py-24 lg:pl-24">
				<SectionHeading title="About" align="left" />
				<p class="mt-8 max-w-md leading-relaxed text-ash">
					{studio.about}
				</p>
				<p class="mt-5 max-w-md leading-relaxed text-ash">
					We work in Unity, care about readable gameplay, and publish first on itch.io while store
					builds are in progress.
				</p>
				<a
					href="/about/"
					class="mt-10 inline-flex w-fit items-center bg-ink px-5 py-2.5 text-sm font-semibold tracking-wide text-ember hover:bg-navy hover:text-ember-2"
				>
					More about the studio
					<span class="ml-3" aria-hidden="true">▸</span>
				</a>
			</div>
			<div class="relative min-h-[360px]">
				<img
					src={featuredGame.cover}
					alt=""
					class="absolute inset-0 h-full w-full object-cover"
				/>
			</div>
		</div>
	</section>

	<div class="geo-band h-14" aria-hidden="true"></div>

	<section id="credits" class="scroll-mt-24 bg-paper px-5 py-20 md:py-24">
		<SectionHeading title="Selected Credits" />
		<p class="mx-auto mt-6 max-w-xl text-center text-ash">
			Shipped as a programmer with other studios. These are work credits — not Kusuma Games products.
		</p>
		<div class="mx-auto mt-12 grid max-w-[980px] grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4">
			{creditGames.map((game) => <CreditCard game={game} />)}
		</div>
	</section>

	<section id="awards" class="bg-paper px-5 pb-20 md:pb-24">
		<SectionHeading title="Awards" />
		<ul class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-3">
			{
				awards.map((award) => (
					<li class="border border-ink/10 bg-paper-2 px-6 py-8 text-center">
						<p class="font-display text-lg font-bold">{award.title}</p>
						<p class="mt-2 text-sm text-ash">
							{award.year} · {award.work}
						</p>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="That page is not on the Kusuma Games site.">
	<section class="mx-auto max-w-3xl px-5 py-24 text-center">
		<p class="font-display text-xs font-bold tracking-[0.22em] text-ember">404</p>
		<h1 class="font-display mt-3 text-4xl font-extrabold">This page wandered off the map.</h1>
		<p class="mt-4 text-ash">The URL does not match a studio page.</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href="/" class="bg-ember px-5 py-2.5 text-sm font-bold text-ink hover:bg-ember-2">Home</a>
			<a href="/games/" class="border border-ink/20 px-5 py-2.5 text-sm font-bold hover:border-ember">
				Games
			</a>
			<a href="/support/" class="border border-ink/20 px-5 py-2.5 text-sm font-bold hover:border-ember">
				Support
			</a>
		</div>
	</section>
</Layout>

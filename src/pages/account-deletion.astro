---
import Layout from "../layouts/Layout.astro";
import LegalDoc from "../components/LegalDoc.astro";
import { studio } from "../data/studio";
import { games } from "../data/games";

const withAccounts = games.filter((game) => game.hasAccounts);
---

<Layout
	title="Account deletion"
	description={`How to delete a Kusuma Games account (Google Sign-In or guest) and related D1 save data.`}
>
	<LegalDoc
		eyebrow="PRIVACY"
		title="Account deletion"
		lede="Google Play requires a public URL where players can request account deletion without installing the app. This is that URL."
	>
		<h2>Games with accounts</h2>
		{
			withAccounts.length === 0 ? (
				<p>
					<strong>No Kusuma Games title currently offers account creation.</strong>
				</p>
			) : (
				<>
					<p>
						These titles offer Google Sign-In and guest login. Deleting the account removes the
						player profile and saves we store in Cloudflare D1, as described below.
					</p>
					<ul>
						{withAccounts.map((game) => (
							<li>
								<a href={`/privacy/${game.slug}/`}>{game.title}</a>
							</li>
						))}
					</ul>
				</>
			)
		}

		<h2>How to delete</h2>
		<ol>
			<li>
				<strong>In the game (required on Google Play):</strong> open Settings (or Account) and
				choose Delete account. Confirm. This should work for both Google Sign-In and guest.
			</li>
			<li>
				<strong>On the web:</strong> email{" "}
				<a href={`mailto:${studio.email}?subject=Delete%20my%20account`}>{studio.email}</a> from
				the Google account you used, or include your guest / player ID from the game’s settings
				screen. Say you want the account and associated game data deleted.
			</li>
		</ol>
		<p>We will confirm when it is gone. We aim to complete this within 30 days.</p>

		<h2>What we delete</h2>
		<ul>
			<li>Your player record in our Cloudflare D1 database (Google-linked or guest)</li>
			<li>Cloud save / progress tied to that account</li>
			<li>Support emails you asked us to delete</li>
		</ul>

		<h2>What we cannot fully undo</h2>
		<ul>
			<li>
				Google Play or App Store purchase history stays with the store. Refunds go through the
				store, not this form.
			</li>
			<li>
				Google Sign-In, Unity LevelPlay ads, and Firebase Analytics records are also processed by
				those companies. You can review Google account, Unity/LevelPlay, and ad settings on their
				sites.
			</li>
			<li>
				Aggregated analytics that no longer identify you may remain.
			</li>
		</ul>

		<p>
			Studio privacy: <a href="/privacy/">Privacy Policy</a>
		</p>
	</LegalDoc>
</Layout>
